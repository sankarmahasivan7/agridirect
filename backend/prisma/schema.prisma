generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique @db.VarChar(190)
  phone              String?             @db.VarChar(20)
  hashedPassword     String              @map("hashed_password") @db.VarChar(255)
  role               roleenum
  isActive           Boolean             @map("is_active")
  isVerified         Boolean             @map("is_verified")
  createdAt          DateTime?           @map("created_at") @db.Timestamp(6)
  buyerProfile       BuyerProfile?
  farmerProfile      FarmerProfile?
  fpoProfile         FpoProfile?
  notifications      Notification[]
  transportRequests  TransportRequest[]
  transporterProfile TransporterProfile?

  @@map("users")
}

model FarmerProfile {
  id            Int              @id @default(autoincrement())
  userId        Int              @unique @map("user_id")
  fullName      String           @map("full_name") @db.VarChar(150)
  villageTown   String?          @map("village_town") @db.VarChar(120)
  district      String?          @db.VarChar(120)
  state         String?          @db.VarChar(120)
  farmLocation  String?          @map("farm_location") @db.VarChar(255)
  farmSizeAcres Decimal?         @map("farm_size_acres") @db.Decimal(10, 2)
  fpoId         Int?             @map("fpo_id")
  farmLatitude  Decimal?         @map("farm_latitude") @db.Decimal(9, 6)
  farmLongitude Decimal?         @map("farm_longitude") @db.Decimal(9, 6)
  user          User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "farmer_profiles_ibfk_1")
  fpo_profiles  FpoProfile?      @relation(fields: [fpoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "farmer_profiles_ibfk_2")
  listings      ProductListing[]
  reviews       Review[]

  @@index([fpoId])
  @@map("farmer_profiles")
}

model FpoProfile {
  id                 Int              @id @default(autoincrement())
  userId             Int              @unique @map("user_id")
  organizationName   String           @map("organization_name") @db.VarChar(200)
  registrationNumber String?          @map("registration_number") @db.VarChar(100)
  location           String?          @db.VarChar(255)
  district           String?          @db.VarChar(120)
  memberCount        Int?             @map("member_count")
  latitude           Decimal?         @db.Decimal(9, 6)
  longitude          Decimal?         @db.Decimal(9, 6)
  farmer_profiles    FarmerProfile[]
  user               User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fpo_profiles_ibfk_1")
  listings           ProductListing[]

  @@map("fpo_profiles")
}

model BuyerProfile {
  id               Int                       @id @default(autoincrement())
  userId           Int                       @unique @map("user_id")
  fullName         String                    @map("full_name") @db.VarChar(150)
  businessName     String?                   @map("business_name") @db.VarChar(200)
  buyerType        buyertypeenum             @map("buyer_type")
  location         String?                   @db.VarChar(255)
  district         String?                   @db.VarChar(120)
  defaultLatitude  Decimal?                  @map("default_latitude") @db.Decimal(9, 6)
  defaultLongitude Decimal?                  @map("default_longitude") @db.Decimal(9, 6)
  bulkRequirements BulkRequirement[]
  user             User                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "buyer_profiles_ibfk_1")
  orders           Order[]
  reviews          Review[]

  @@map("buyer_profiles")
}

model TransporterProfile {
  id            Int             @id @default(autoincrement())
  userId        Int             @unique @map("user_id")
  fullName      String          @map("full_name") @db.VarChar(150)
  licenseNumber String?         @map("license_number") @db.VarChar(100)
  baseLocation  String?         @map("base_location") @db.VarChar(255)
  district      String?         @db.VarChar(120)
  isAvailable   Boolean         @map("is_available")
  baseLatitude  Decimal?        @map("base_latitude") @db.Decimal(9, 6)
  baseLongitude Decimal?        @map("base_longitude") @db.Decimal(9, 6)
  batches       DeliveryBatch[]
  user          User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transporter_profiles_ibfk_1")
  vehicle       Vehicle?

  @@map("transporter_profiles")
}

model Vehicle {
  id                Int                 @id @default(autoincrement())
  transporterId     Int?                @unique @map("transporter_id")
  name              String?             @db.VarChar(100)
  vehicleNumber     String?             @map("vehicle_number") @db.VarChar(50)
  vehicleType       String?             @map("vehicle_type") @db.VarChar(50)
  capacityKg        Decimal             @map("capacity_kg") @db.Decimal(10, 2)
  isActive          Boolean?            @map("is_active")
  currentLatitude   Decimal?            @map("current_latitude") @db.Decimal(9, 6)
  currentLongitude  Decimal?            @map("current_longitude") @db.Decimal(9, 6)
  locationLabel     String?             @map("location_label") @db.VarChar(255)
  locationUpdatedAt DateTime?           @map("location_updated_at") @db.Timestamp(6)
  deliveries        deliveries[]
  batches           DeliveryBatch[]
  transportRequests TransportRequest[]
  transporter       TransporterProfile? @relation(fields: [transporterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vehicles_ibfk_1")

  @@map("vehicles")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  parentGroup String?   @map("parent_group") @db.VarChar(100)
  products    Product[]

  @@map("categories")
}

model Product {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(150)
  categoryId         Int                  @map("category_id")
  defaultUnit        String?              @map("default_unit") @db.VarChar(20)
  bulkRequirements   BulkRequirement[]
  demand_data        demand_data[]
  demand_predictions demand_predictions[]
  price_predictions  price_predictions[]
  listings           ProductListing[]
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_1")
  reviews            Review[]

  @@unique([name, categoryId], map: "uq_product_name_category")
  @@index([categoryId])
  @@map("products")
}

model ProductListing {
  id                 Int                 @id @default(autoincrement())
  productId          Int                 @map("product_id")
  farmerId           Int?                @map("farmer_id")
  fpoId              Int?                @map("fpo_id")
  quantityAvailable  Decimal             @map("quantity_available") @db.Decimal(12, 2)
  unit               String              @db.VarChar(20)
  pricePerUnit       Decimal             @map("price_per_unit") @db.Decimal(10, 2)
  qualityGrade       String?             @map("quality_grade") @db.VarChar(50)
  harvestDate        DateTime?           @map("harvest_date") @db.Date
  availableFrom      DateTime?           @map("available_from") @db.Date
  availableUntil     DateTime?           @map("available_until") @db.Date
  location           String?             @db.VarChar(255)
  minOrderQuantity   Decimal?            @map("min_order_quantity") @db.Decimal(12, 2)
  isPerishable       Boolean?            @map("is_perishable")
  shelfLifeDays      Int?                @map("shelf_life_days")
  expectedSellByDate DateTime?           @map("expected_sell_by_date") @db.Date
  perishabilityLevel String?             @map("perishability_level") @db.VarChar(30)
  storageRequirement String?             @map("storage_requirement") @db.VarChar(255)
  certificationInfo  String?             @map("certification_info") @db.VarChar(255)
  imageUrl           String?             @map("image_url") @db.VarChar(500)
  isActive           Boolean             @map("is_active")
  createdAt          DateTime?           @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  orderItems         OrderItem[]
  price_predictions  price_predictions[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_listings_ibfk_1")
  farmer             FarmerProfile?      @relation(fields: [farmerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_listings_ibfk_2")
  fpo                FpoProfile?         @relation(fields: [fpoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "product_listings_ibfk_3")
  reviews            Review[]
  supplier_matches   SupplierMatch[]

  @@index([farmerId])
  @@index([fpoId])
  @@index([productId, isActive])
  @@map("product_listings")
}

model Order {
  id                          Int                    @id @default(autoincrement())
  buyerId                     Int                    @map("buyer_id")
  subtotal                    Decimal                @db.Decimal(12, 2)
  logisticsCost               Decimal                @map("logistics_cost") @db.Decimal(12, 2)
  platformFee                 Decimal                @map("platform_fee") @db.Decimal(12, 2)
  totalAmount                 Decimal                @map("total_amount") @db.Decimal(12, 2)
  deliveryLocation            String?                @map("delivery_location") @db.VarChar(255)
  deliveryLatitude            Decimal?               @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude           Decimal?               @map("delivery_longitude") @db.Decimal(9, 6)
  status                      orderstatusenum
  createdAt                   DateTime?              @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime?              @updatedAt @map("updated_at") @db.Timestamp(6)
  paymentMethod               paymentmethodenum?     @map("payment_method")
  paymentStatus               paymentstatusenum      @default(PENDING) @map("payment_status")
  paidAt                      DateTime?              @map("paid_at") @db.Timestamp(6)
  farmerSettlementAmount      Decimal                @default(0.00) @map("farmer_settlement_amount") @db.Decimal(12, 2)
  transporterSettlementAmount Decimal                @default(0.00) @map("transporter_settlement_amount") @db.Decimal(12, 2)
  platformCommissionAmount    Decimal                @default(0.00) @map("platform_commission_amount") @db.Decimal(12, 2)
  baseFare                    Decimal?               @map("base_fare") @db.Decimal(10, 2)
  distanceFare                Decimal?               @map("distance_fare") @db.Decimal(10, 2)
  tollCharges                 Decimal?               @default(0.00) @map("toll_charges") @db.Decimal(10, 2)
  loadingUnloadingCharge      Decimal?               @default(0.00) @map("loading_unloading_charge") @db.Decimal(10, 2)
  waitingCharge               Decimal?               @default(0.00) @map("waiting_charge") @db.Decimal(10, 2)
  roadDistanceKm              Decimal?               @map("road_distance_km") @db.Decimal(10, 2)
  allocatedVehicleType        String?                @map("allocated_vehicle_type") @db.VarChar(50)
  deliveryOtp                 String?                @map("delivery_otp") @db.VarChar(6)
  batch_stops                 BatchStop[]
  deliveries                  deliveries[]
  fulfillmentItems            OrderFulfillmentItem[]
  items                       OrderItem[]
  buyer                       BuyerProfile           @relation(fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_ibfk_1")
  payment                     Payment?
  reviews                     Review[]
  transactions                transactions[]
  transportRequests           TransportRequest[]

  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id               Int                    @id @default(autoincrement())
  orderId          Int                    @map("order_id")
  listingId        Int                    @map("listing_id")
  quantity         Decimal                @db.Decimal(12, 2)
  priceAtPurchase  Decimal                @map("price_at_purchase") @db.Decimal(10, 2)
  lineSubtotal     Decimal                @map("line_subtotal") @db.Decimal(12, 2)
  fulfillmentItems OrderFulfillmentItem[]
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_1")
  listing          ProductListing         @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_2")

  @@index([listingId])
  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                Int                     @id @default(autoincrement())
  orderId           Int                     @unique @map("order_id")
  amount            Decimal                 @db.Decimal(12, 2)
  currency          String                  @db.VarChar(10)
  paymentMethod     paymentmethodenum       @map("payment_method")
  paymentStatus     paymentstatusenum       @map("payment_status")
  gateway           String?                 @db.VarChar(50)
  gatewayOrderId    String?                 @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId  String?                 @map("gateway_payment_id") @db.VarChar(100)
  gatewaySignature  String?                 @map("gateway_signature") @db.VarChar(255)
  farmerAmount      Decimal                 @map("farmer_amount") @db.Decimal(12, 2)
  transporterAmount Decimal                 @map("transporter_amount") @db.Decimal(12, 2)
  commissionAmount  Decimal                 @map("commission_amount") @db.Decimal(12, 2)
  paidAt            DateTime?               @map("paid_at") @db.Timestamp(6)
  createdAt         DateTime?               @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?               @updatedAt @map("updated_at") @db.Timestamp(6)
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payments_ibfk_1")

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model TransportRequest {
  id                        Int            @id @default(autoincrement())
  requestedByUserId         Int            @map("requested_by_user_id")
  orderId                   Int?           @map("order_id")
  batchId                   Int?           @map("batch_id")
  pickupLocation            String         @map("pickup_location") @db.VarChar(255)
  pickupLatitude            Decimal?       @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude           Decimal?       @map("pickup_longitude") @db.Decimal(9, 6)
  destinationLocation       String         @map("destination_location") @db.VarChar(255)
  destinationLatitude       Decimal?       @map("destination_latitude") @db.Decimal(9, 6)
  destinationLongitude      Decimal?       @map("destination_longitude") @db.Decimal(9, 6)
  requiredBy                DateTime       @map("required_by") @db.Timestamp(6)
  availableFrom             DateTime?      @map("available_from") @db.Date
  weightKg                  Decimal        @map("weight_kg") @db.Decimal(10, 2)
  notes                     String?        @db.VarChar(500)
  status                    transportrequeststatusenum @default(PENDING)
  assignedVehicleId         Int?           @map("assigned_vehicle_id")
  logisticsStrategy         String         @map("logistics_strategy") @db.VarChar(50)
  hubName                   String?        @map("hub_name") @db.VarChar(255)
  distanceKm                Decimal?       @map("distance_km") @db.Decimal(10, 2)
  logisticsCost             Decimal?       @map("logistics_cost") @db.Decimal(10, 2)
  vehicleCapacityKg         Decimal?       @map("vehicle_capacity_kg") @db.Decimal(10, 2)
  isPerishable              Boolean?       @map("is_perishable")
  perishabilityUrgency      String?        @map("perishability_urgency") @db.VarChar(30)
  storageRequirement        String?        @map("storage_requirement") @db.VarChar(255)
  in_transit_at             DateTime?      @db.Timestamp(6)
  estimated_transit_minutes Int?
  createdAt                 DateTime?      @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime?      @updatedAt @map("updated_at") @db.Timestamp(6)
  baseFare                  Decimal?       @map("base_fare") @db.Decimal(10, 2)
  distanceFare              Decimal?       @map("distance_fare") @db.Decimal(10, 2)
  tollCharges               Decimal?       @default(0.00) @map("toll_charges") @db.Decimal(10, 2)
  loadingUnloadingCharge    Decimal?       @default(0.00) @map("loading_unloading_charge") @db.Decimal(10, 2)
  waitingCharge             Decimal?       @default(0.00) @map("waiting_charge") @db.Decimal(10, 2)
  roadDistanceKm            Decimal?       @map("road_distance_km") @db.Decimal(10, 2)
  allocatedVehicleType      String?        @map("allocated_vehicle_type") @db.VarChar(50)
  requestedBy               User           @relation(fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transport_requests_ibfk_1")
  order                     Order?         @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transport_requests_ibfk_2")
  batch                     DeliveryBatch? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transport_requests_ibfk_3")
  assignedVehicle           Vehicle?       @relation(fields: [assignedVehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transport_requests_ibfk_4")

  @@index([assignedVehicleId])
  @@index([batchId])
  @@index([orderId])
  @@index([requestedByUserId])
  @@map("transport_requests")
}

model DeliveryBatch {
  id                        Int                     @id @default(autoincrement())
  batchCode                 String                  @unique @map("batch_code") @db.VarChar(50)
  deliveryArea              String                  @map("delivery_area") @db.VarChar(120)
  totalQuantityKg           Decimal                 @map("total_quantity_kg") @db.Decimal(12, 2)
  totalOrdersCount          Int                     @map("total_orders_count")
  totalCustomersCount       Int                     @map("total_customers_count")
  requiredVehicleCapacityKg Decimal                 @map("required_vehicle_capacity_kg") @db.Decimal(12, 2)
  estimatedDistanceKm       Decimal?                @map("estimated_distance_km") @db.Decimal(10, 2)
  estimatedLogisticsCost    Decimal?                @map("estimated_logistics_cost") @db.Decimal(12, 2)
  status                    deliverybatchstatusenum
  assignedTransporterId     Int?                    @map("assigned_transporter_id")
  assignedVehicleId         Int?                    @map("assigned_vehicle_id")
  pickup_deadline           DateTime?               @db.Timestamp(6)
  delivery_deadline         DateTime?               @db.Timestamp(6)
  earliest_available_date   DateTime?               @db.Date
  in_transit_at             DateTime?               @db.Timestamp(6)
  estimated_transit_minutes Int?
  createdAt                 DateTime?               @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime?               @updatedAt @map("updated_at") @db.Timestamp(6)
  base_fare                 Decimal?                @db.Decimal(10, 2)
  distance_fare             Decimal?                @db.Decimal(10, 2)
  toll_charges              Decimal?                @default(0.00) @db.Decimal(10, 2)
  loading_unloading_charge  Decimal?                @default(0.00) @db.Decimal(10, 2)
  waiting_charge            Decimal?                @default(0.00) @db.Decimal(10, 2)
  allocated_vehicle_type    String?                 @db.VarChar(50)
  stops                     BatchStop[]
  transporter               TransporterProfile?     @relation(fields: [assignedTransporterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_batches_ibfk_1")
  vehicle                   Vehicle?                @relation(fields: [assignedVehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_batches_ibfk_2")
  fulfillmentItems          OrderFulfillmentItem[]
  transportRequests         TransportRequest[]

  @@index([assignedTransporterId])
  @@index([assignedVehicleId])
  @@map("delivery_batches")
}

model OrderFulfillmentItem {
  id                 Int            @id @default(autoincrement())
  orderId            Int            @map("order_id")
  orderItemId        Int            @map("order_item_id")
  warehouseName      String         @map("warehouse_name") @db.VarChar(255)
  warehouseCode      String         @map("warehouse_code") @db.VarChar(50)
  warehouseDistrict  String         @map("warehouse_district") @db.VarChar(120)
  warehouseLatitude  Decimal?       @map("warehouse_latitude") @db.Decimal(9, 6)
  warehouseLongitude Decimal?       @map("warehouse_longitude") @db.Decimal(9, 6)
  quantity           Decimal        @db.Decimal(12, 2)
  status             String         @db.VarChar(50)
  batchId            Int?           @map("batch_id")
  availableFrom      DateTime?      @map("available_from") @db.Date
  createdAt          DateTime?      @map("created_at") @db.Timestamp(6)
  order              Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_fulfillment_items_ibfk_1")
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_fulfillment_items_ibfk_2")
  batch              DeliveryBatch? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_fulfillment_items_ibfk_3")

  @@index([batchId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("order_fulfillment_items")
}

model BatchStop {
  id           Int           @id @default(autoincrement())
  batchId      Int           @map("batch_id")
  stopType     String        @map("stop_type") @db.VarChar(20)
  sequence     Int
  locationName String        @map("location_name") @db.VarChar(255)
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  cargoKg      Decimal?      @map("cargo_kg") @db.Decimal(10, 2)
  orderId      Int?          @map("order_id")
  customerName String?       @map("customer_name") @db.VarChar(150)
  notes        String?       @db.VarChar(500)
  status       String        @db.VarChar(30)
  batch        DeliveryBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "batch_stops_ibfk_1")
  orders       Order?        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "batch_stops_ibfk_2")

  @@index([batchId])
  @@index([orderId])
  @@map("batch_stops")
}

model BulkRequirement {
  id                Int             @id @default(autoincrement())
  buyerId           Int             @map("buyer_id")
  productId         Int             @map("product_id")
  requiredQuantity  Decimal         @map("required_quantity") @db.Decimal(12, 2)
  unit              String?         @db.VarChar(20)
  neededBy          DateTime?       @map("needed_by") @db.Date
  deliveryLocation  String?         @map("delivery_location") @db.VarChar(255)
  qualityGrade      String?         @map("quality_grade") @db.VarChar(50)
  deliveryLatitude  Decimal?        @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude Decimal?        @map("delivery_longitude") @db.Decimal(9, 6)
  status            String?         @db.VarChar(30)
  createdAt         DateTime?       @map("created_at") @db.Timestamp(6)
  buyer             BuyerProfile    @relation(fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bulk_requirements_ibfk_1")
  product           Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bulk_requirements_ibfk_2")
  matches           SupplierMatch[]

  @@index([buyerId])
  @@index([productId])
  @@map("bulk_requirements")
}

model SupplierMatch {
  id               Int             @id @default(autoincrement())
  requirementId    Int             @map("requirement_id")
  listingId        Int             @map("listing_id")
  matchedQuantity  Decimal         @map("matched_quantity") @db.Decimal(12, 2)
  farmerPrice      Decimal?        @map("farmer_price") @db.Decimal(10, 2)
  logisticsCost    Decimal?        @map("logistics_cost") @db.Decimal(10, 2)
  platformFee      Decimal?        @map("platform_fee") @db.Decimal(10, 2)
  requirement      BulkRequirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supplier_matches_ibfk_1")
  listing          ProductListing  @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supplier_matches_ibfk_2")

  @@index([listingId])
  @@index([requirementId])
  @@map("supplier_matches")
}

model Review {
  id              Int             @id @default(autoincrement())
  orderId         Int             @map("order_id")
  buyerId         Int             @map("buyer_id")
  farmerId        Int?            @map("farmer_id")
  listingId       Int?            @map("listing_id")
  productId       Int?            @map("product_id")
  productName     String?         @map("product_name") @db.VarChar(150)
  rating          Int
  comment         String?         @db.Text
  imageUrl        String?         @map("image_url") @db.VarChar(500)
  isWasteReported Boolean         @map("is_waste_reported")
  createdAt       DateTime?       @map("created_at") @db.Timestamp(6)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_1")
  buyer           BuyerProfile    @relation(fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_2")
  farmer          FarmerProfile?  @relation(fields: [farmerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_3")
  listing         ProductListing? @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_4")
  product         Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_5")

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([orderId])
  @@index([productId])
  @@map("reviews")
}

model Notification {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  title            String    @db.VarChar(200)
  message          String?   @db.Text
  notificationType String?   @map("notification_type") @db.VarChar(50)
  link             String?   @db.VarChar(255)
  isRead           Boolean?  @map("is_read")
  createdAt        DateTime? @map("created_at") @db.Timestamp(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([userId])
  @@map("notifications")
}

model deliveries {
  id             Int              @id @default(autoincrement())
  order_id       Int
  vehicle_id     Int?
  status         String?          @db.VarChar(30)
  is_simulated   Boolean
  created_at     DateTime?        @db.Timestamp(6)
  orders         Order            @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deliveries_ibfk_1")
  vehicles       Vehicle?         @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deliveries_ibfk_2")
  delivery_stops delivery_stops[]

  @@index([order_id])
  @@index([vehicle_id])
}

model delivery_stops {
  id          Int        @id @default(autoincrement())
  delivery_id Int
  sequence    Int
  location_id Int?
  label       String?    @db.VarChar(255)
  eta         DateTime?  @db.Timestamp(6)
  deliveries  deliveries @relation(fields: [delivery_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_stops_ibfk_1")
  locations   locations? @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_stops_ibfk_2")

  @@index([delivery_id])
  @@index([location_id])
}

model demand_data {
  id              Int      @id @default(autoincrement())
  product_id      Int
  location        String?  @db.VarChar(120)
  record_date     DateTime @db.Date
  demand_quantity Decimal  @db.Decimal(12, 2)
  price           Decimal  @db.Decimal(10, 2)
  is_festival     Boolean?
  is_synthetic    Boolean
  products        Product  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "demand_data_ibfk_1")

  @@index([product_id])
}

model demand_predictions {
  id                 Int       @id @default(autoincrement())
  product_id         Int
  location           String?   @db.VarChar(120)
  target_date        DateTime  @db.Date
  predicted_quantity Decimal   @db.Decimal(12, 2)
  model_version      String?   @db.VarChar(50)
  mae                Decimal?  @db.Decimal(10, 3)
  rmse               Decimal?  @db.Decimal(10, 3)
  r2                 Decimal?  @db.Decimal(10, 4)
  created_at         DateTime? @db.Timestamp(6)
  products           Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "demand_predictions_ibfk_1")

  @@index([product_id])
}

model locations {
  id             Int              @id @default(autoincrement())
  label          String?          @db.VarChar(255)
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  delivery_stops delivery_stops[]
}

model logistics_settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique @db.VarChar(100)
  setting_value String    @db.VarChar(255)
  description   String?   @db.VarChar(255)
  updated_at    DateTime? @db.Timestamp(6)
}

model platform_settings {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(100)
  value String @db.VarChar(255)
}

model price_predictions {
  id               Int             @id @default(autoincrement())
  listing_id       Int?
  product_id       Int
  recommended_min  Decimal         @db.Decimal(10, 2)
  recommended_max  Decimal         @db.Decimal(10, 2)
  reasoning        String?         @db.Text
  created_at       DateTime?       @db.Timestamp(6)
  product_listings ProductListing? @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "price_predictions_ibfk_1")
  products         Product         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "price_predictions_ibfk_2")

  @@index([listing_id])
  @@index([product_id])
}

model transactions {
  id                       Int       @id @default(autoincrement())
  order_id                 Int
  platform_fee_amount      Decimal   @db.Decimal(12, 2)
  logistics_revenue_amount Decimal   @db.Decimal(12, 2)
  created_at               DateTime? @db.Timestamp(6)
  orders                   Order     @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transactions_ibfk_1")

  @@index([order_id])
}

model vehicle_rates {
  id                       Int       @id @default(autoincrement())
  vehicle_type             String    @unique @db.VarChar(50)
  base_fare                Decimal   @db.Decimal(10, 2)
  rate_per_km              Decimal   @db.Decimal(10, 2)
  minimum_fare             Decimal   @db.Decimal(10, 2)
  loading_unloading_charge Decimal   @db.Decimal(10, 2)
  waiting_charge_per_hour  Decimal   @db.Decimal(10, 2)
  active                   Boolean
  created_at               DateTime? @db.Timestamp(6)
  updated_at               DateTime? @db.Timestamp(6)
}

enum roleenum {
  farmer
  buyer
  fpo
  admin
  transporter
}

