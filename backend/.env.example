# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection. Example: mysql+pymysql://agridirect:password@localhost:3306/agridirect
DATABASE_URL=mysql+pymysql://agridirect:agridirect@localhost:3306/agridirect

# For quick local testing without MySQL installed, you can instead use SQLite:
# DATABASE_URL=sqlite:///./agridirect.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business config
PLATFORM_FEE_PERCENT=2.0
LOGISTICS_BASE_RATE_PER_KG=4.0

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Admin seed (used only by scripts/create_admin.py)
ADMIN_EMAIL=admin@agridirect.ai
ADMIN_PASSWORD=change-this-admin-password

# Razorpay Test Mode API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PhonePe UPI QR Configuration
DEFAULT_UPI_ID=8870862195@axl
DEFAULT_UPI_NAME=SEYED MOHAMMED SAFIN

# Real Road Mapping & Routing (Google Maps API / OSRM)
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=auto

# Gemini AI Decision Layer & Voice Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

