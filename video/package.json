{
  "name": "agridirect-promo-video",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "AgriDirect 90-Second Cinematic Promotional Video built with Remotion & React",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "preview": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts AgriDirectPromo out/agridirect_promo.mp4",
    "render": "remotion render src/index.ts AgriDirectPromo out/agridirect_promo.mp4",
    "still": "remotion still src/index.ts AgriDirectPromo out/preview.png",
    "capture": "node scripts/capture_screens.js"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.220",
    "@remotion/paths": "^4.0.220",
    "@remotion/transitions": "^4.0.220",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "puppeteer-core": "^23.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.220",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
